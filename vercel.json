{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "laya": {
      "root": "client/laya",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "server",
          "format": "url",
          "env": "SERVER_URL"
        }
      ]
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "index.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "laya",
        "path": "/assets/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "laya",
        "path": "/index.html"
      }
    }
  ]
}
